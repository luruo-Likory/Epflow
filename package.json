{
  "name": "epflow",
  "productName": "EpFlow",
  "version": "1.0.0",
  "description": "番剧字幕审阅 · 压制 · 章节 · 发布流程规范化软件",
  "main": "dist/main/index.js",
  "author": {
    "name": "EpFlow",
    "email": "epflow@localhost"
  },
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build:renderer && npm run build:main",
    "build:renderer": "vite build",
    "build:main": "node scripts/build-main.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "pack": "npm run build && electron-builder --win --dir",
    "dist": "npm run build && electron-builder --win",
    "dist:portable": "npm run build && electron-builder --win portable"
  },
  "dependencies": {
    "@tanstack/react-virtual": "3.14.21",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "zod": "3.25.76",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "40.10.6",
    "electron-builder": "26.17.0",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "3.2.7"
  },
  "allowScripts": {
    "electron@40.10.6": true,
    "electron-winstaller@5.4.0": true,
    "esbuild@0.28.2": true
  }
}
